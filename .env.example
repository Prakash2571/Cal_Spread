# Copy to ".env" if you need to override the backend URL.
# Defaults to http://localhost:3001 when unset.
# NOTE: When testing the Zerodha login flow, browse the app via
# http://127.0.0.1:5173 (to match the Kite Redirect URL). Pointing this at
# http://127.0.0.1:3001 keeps the backend on the same host, which is tidiest.
VITE_API_BASE_URL=http://127.0.0.1:3001
